# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit actual credentials.

# Required: SLUGGER API key — contact the SARG team or ALPB platform admins to obtain one.
SLUGGER_API_KEY=your-slugger-api-key-here

# Optional: override the API base URL (defaults to the ALPB production endpoint).
# SLUGGER_BASE_URL=https://1ywv9dczq5.execute-api.us-east-2.amazonaws.com/ALPBAPI

# Optional: override the port the local server listens on (defaults to 8080).
# PORT=8080

# Optional: iScore club rosters (the Team menu). The league GUID may change between
# seasons — if teams stop appearing in the Team menu, check this first.
# ISCORE_LEAGUE_GUID=df9fb9cc-0fdb-4b79-8a3c-ad5d7b415a56
# ISCORE_BASE_URL=https://api.microservices.iscoresports.com/api

# Optional: a hitter counts as on a club's roster if he batted for it within this
# many days of the season's last game (default 21).
# ROSTER_ACTIVITY_DAYS=21
